{
  "name": "ایران",
  "version": "0.54.0",
  "model": {
    "provider": "iran",
    "name": "Iran Symbolic Core",
    "mode": "offline-symbolic"
  },
  "memory": {
    "db": "data/iran.db",
    "max_history": 16,
    "search_limit": 12
  },
  "security": {
    "safe_mode": true,
    "allow_shell": false,
    "allow_network_tools": false
  },
  "self_improvement": {
    "enabled": true,
    "sandbox": "sandbox",
    "auto_deploy": false,
    "require_tests": true
  },
  "autonomy": {
    "enabled": true,
    "mode": "local-safe-read-only",
    "auto_start": false,
    "max_cycles": 100
  },
  "runtime": {
    "event_log": "logs/events.jsonl",
    "goals": "data/goals.json",
    "service_interval": 10,
    "autonomy_journal": "data/autonomy_journal.json",
    "autonomous_goal_state": "data/autonomous_goal_state.json"
  },
  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openrouter/free",
    "timeout": 45
  },
  "learning_validation": {
    "enabled": true
  },
  "reviewers": {
    "max_attempts": 4,
    "max_seconds": 40,
    "providers": {
      "openrouter": {
        "enabled": true,
        "base_url": "https://openrouter.ai/api/v1",
        "key_env": "OPENROUTER_API_KEY",
        "model_env": "OPENROUTER_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        },
        "dynamic_free_models": true,
        "free_model_limit": 25,
        "model_attempts": 4,
        "free_models_ttl": 900
      },
      "gemini": {
        "enabled": false,
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "key_env": "GEMINI_API_KEY",
        "model_env": "GEMINI_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "groq": {
        "enabled": false,
        "base_url": "https://api.groq.com/openai/v1",
        "key_env": "GROQ_API_KEY",
        "model_env": "GROQ_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "cerebras": {
        "enabled": false,
        "base_url": "https://api.cerebras.ai/v1",
        "key_env": "CEREBRAS_API_KEY",
        "model_env": "CEREBRAS_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "mistral": {
        "enabled": false,
        "base_url": "https://api.mistral.ai/v1",
        "key_env": "MISTRAL_API_KEY",
        "model_env": "MISTRAL_MODEL",
        "model": "mistral-small-latest",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [
            "mistral-small-latest"
          ],
          "expires_at": ""
        }
      }
    }
  },
  "learning_sources": [],
  "external_access": {
    "credential_free_only": true,
    "zero_budget_credentials_allowed": true
  },
  "language_engine": {
    "enabled": true,
    "backend": "local_http",
    "model": "qwen2.5-1.5b-instruct-q4_k_m.gguf",
    "endpoint": "http://127.0.0.1:18080/v1/chat/completions",
    "timeout": 20,
    "policy": "CognitiveSystem remains ONE BRAIN; local generation only"
  }
}
