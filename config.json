{
  "name": "ایران",
  "version": "0.54.0",
  "model": {
    "provider": "iran",
    "name": "Iran Symbolic Core",
    "mode": "offline-symbolic"
  },
  "memory": {
    "db": "data/iran.db",
    "max_history": 16,
    "search_limit": 12
  },
  "security": {
    "safe_mode": true,
    "allow_shell": false,
    "allow_network_tools": false
  },
  "self_improvement": {
    "enabled": true,
    "sandbox": "sandbox",
    "auto_deploy": false,
    "require_tests": true
  },
  "autonomy": {
    "enabled": true,
    "mode": "local-safe-read-only",
    "auto_start": false,
    "max_cycles": 100
  },
  "runtime": {
    "event_log": "logs/events.jsonl",
    "goals": "data/goals.json",
    "service_interval": 10,
    "autonomy_journal": "data/autonomy_journal.json",
    "autonomous_goal_state": "data/autonomous_goal_state.json"
  },
  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openrouter/free",
    "timeout": 45
  },
  "learning_validation": {
    "enabled": true
  },
  "reviewers": {
    "max_attempts": 4,
    "max_seconds": 40,
    "providers": {
      "openrouter": {
        "enabled": false,
        "base_url": "https://openrouter.ai/api/v1",
        "key_env": "OPENROUTER_API_KEY",
        "model_env": "OPENROUTER_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "gemini": {
        "enabled": false,
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "key_env": "GEMINI_API_KEY",
        "model_env": "GEMINI_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "groq": {
        "enabled": false,
        "base_url": "https://api.groq.com/openai/v1",
        "key_env": "GROQ_API_KEY",
        "model_env": "GROQ_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      },
      "cerebras": {
        "enabled": false,
        "base_url": "https://api.cerebras.ai/v1",
        "key_env": "CEREBRAS_API_KEY",
        "model_env": "CEREBRAS_MODEL",
        "model": "",
        "timeout": 10,
        "retries": 0,
        "cooldown": 60,
        "min_interval": 15,
        "free_policy": {
          "budget": 0,
          "confirmed": false,
          "models": [],
          "expires_at": ""
        }
      }
    }
  },
  "learning_sources": [],
  "external_access": {
    "credential_free_only": true
  }
}
